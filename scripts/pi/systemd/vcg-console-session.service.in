[Unit]
Description=VCG Console fullscreen TV session
Requires=vcg-console-server.service
After=bluetooth.service vcg-console-server.service systemd-user-sessions.service dbus.socket systemd-logind.service
Wants=dbus.socket systemd-logind.service
PartOf=vcg-console.target
Conflicts=getty@tty1.service
After=getty@tty1.service
ConditionPathExists=/dev/tty1
StartLimitIntervalSec=0

[Service]
Type=simple
User=@CONSOLE_USER@
Group=@CONSOLE_GROUP@
PAMName=login
WorkingDirectory=@REPO_ROOT@
Environment=HOME=@CONSOLE_HOME@
Environment=XDG_RUNTIME_DIR=/run/vcg-console
Environment=XDG_CACHE_HOME=/var/lib/vcg-console/cache
Environment=XDG_CONFIG_HOME=/var/lib/vcg-console/config
Environment=XDG_DATA_HOME=/var/lib/vcg-console/data
RuntimeDirectory=vcg-console
RuntimeDirectoryMode=0700
StateDirectory=vcg-console
StateDirectoryMode=0750
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty-fail
StandardOutput=journal
StandardError=journal
UtmpIdentifier=tty1
UtmpMode=user
ExecStartPre=@REPO_ROOT@/scripts/pi/wait-for-console.sh @REPO_ROOT@
ExecStart=@CAGE_PATH@ -- @LAUNCHER_COMMAND@
Restart=always
RestartSec=3
TimeoutStopSec=15
KillMode=control-group
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
# PAMName=login's pam_systemd sets XDG_RUNTIME_DIR to the real login-session
# runtime directory (/run/user/<uid>) for the session it opens, taking
# precedence over the Environment= line above. Cage/Chromium end up creating
# their Wayland socket and lockfiles there, not under /run/vcg-console, so it
# must be writable too or every launch fails with "Unable to open Wayland
# socket: Invalid argument" after exhausting all wayland-0..31 lock attempts.
# Confirmed live on the Pi 5.
ReadWritePaths=/var/lib/vcg-console /run/vcg-console /run/user/@CONSOLE_UID@
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK

[Install]
WantedBy=vcg-console.target
