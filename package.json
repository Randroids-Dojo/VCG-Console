{
  "name": "vcg-console",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --filter @vcg/console-lab dev",
    "prepare:assets": "node scripts/prepare-assets.mjs",
    "prepare:schemas": "tsx scripts/export-schemas.ts",
    "supervise:game": "tsx scripts/supervise-web-game.ts",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter @vcg/console-lab test:e2e",
    "typecheck": "pnpm -r typecheck",
    "validate:manifests": "tsx scripts/validate-game-manifests.ts"
  },
  "devDependencies": {
    "@vcg/game-manifest": "workspace:*",
    "tsx": "4.21.0",
    "typescript": "5.9.3"
  }
}
