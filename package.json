{
  "name": "vcg-console",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "benchmark:transports": "tsx scripts/benchmark-motion-transports.mjs",
    "build": "pnpm -r build",
    "dev": "pnpm --filter @vcg/console-lab dev",
    "prepare:assets": "node scripts/prepare-assets.mjs",
    "prepare:catalog": "tsx scripts/export-launcher-catalog.ts",
    "prepare:compliance": "node scripts/generate-compliance.mjs",
    "prepare:retro-core-sbom": "node scripts/generate-retro-core-sbom.mjs",
    "prepare:schemas": "tsx scripts/export-schemas.ts",
    "native:check": "cargo check --workspace",
    "native:fmt": "cargo fmt --all -- --check",
    "native:lint": "cargo clippy --workspace --all-targets -- -D warnings",
    "native:test": "cargo test --workspace",
    "native:verify": "pnpm native:fmt && pnpm native:lint && pnpm native:test",
    "supervise:game": "tsx scripts/supervise-web-game.ts",
    "test": "tsx --test scripts/hosted-browser-supervisor.test.ts && tsx --test scripts/validate-epoch-top-level-evidence.test.mjs && tsx --test scripts/validate-godot-export-evidence.test.mjs && tsx --test scripts/validate-godot-web-bridge-evidence.test.mjs && tsx --test scripts/validate-godot-web-bridge-resilience-evidence.test.mjs && node --test scripts/validate-tv-conformance-evidence.test.mjs && node --test scripts/validate-retro-core-sbom.test.mjs && tsx --test scripts/validate-body-profile-prediction-evidence.test.mjs && tsx --test scripts/validate-motion-bridge-wall-clock-evidence.test.mjs && pnpm -r test",
    "test:e2e": "pnpm --filter @vcg/console-lab test:e2e",
    "typecheck": "tsc --noEmit --target ES2023 --module ESNext --moduleResolution Bundler --esModuleInterop --skipLibCheck --types node --typeRoots apps/console-lab/node_modules/@types scripts/hosted-browser-supervisor.ts scripts/hosted-browser-supervisor.test.ts scripts/supervise-web-game.ts && pnpm -r typecheck",
    "validate:benchmarks": "tsx scripts/validate-motion-benchmarks.ts",
    "validate:body-profile-prediction": "tsx scripts/validate-body-profile-prediction-evidence.mjs && tsx --test scripts/validate-body-profile-prediction-evidence.test.mjs",
    "validate:compliance": "node scripts/generate-compliance.mjs --check",
    "validate:data-exclusion": "node --test scripts/device-only-data-exclusion.test.mjs && tsx --test scripts/local-diagnostics-data-exclusion.test.ts",
    "validate:epoch-top-level": "tsx scripts/validate-epoch-top-level-evidence.mjs && tsx --test scripts/validate-epoch-top-level-evidence.test.mjs",
    "validate:godot": "node scripts/validate-godot-motion-sample.mjs",
    "validate:godot-exports": "tsx scripts/validate-godot-export-evidence.mjs && tsx --test scripts/validate-godot-export-evidence.test.mjs",
    "validate:godot-web-bridge": "tsx scripts/validate-godot-web-bridge-evidence.mjs && tsx --test scripts/validate-godot-web-bridge-evidence.test.mjs",
    "validate:godot-web-bridge-resilience": "tsx scripts/validate-godot-web-bridge-resilience-evidence.mjs && tsx --test scripts/validate-godot-web-bridge-resilience-evidence.test.mjs",
    "validate:manifests": "tsx scripts/validate-game-manifests.ts",
    "validate:motion-bridge-wall-clock": "tsx scripts/validate-motion-bridge-wall-clock-evidence.mjs && tsx --test scripts/validate-motion-bridge-wall-clock-evidence.test.mjs",
    "validate:release-compliance": "node scripts/generate-compliance.mjs --check --release",
    "validate:retro-core-sbom": "node scripts/generate-retro-core-sbom.mjs --check && node --test scripts/validate-retro-core-sbom.test.mjs",
    "validate:schemas": "tsx scripts/export-schemas.ts --check",
    "validate:tv-conformance": "node scripts/validate-tv-conformance-evidence.mjs && node --test scripts/validate-tv-conformance-evidence.test.mjs",
    "validate:transport-benchmarks": "tsx --test scripts/motion-transport-payload.test.mjs && node scripts/validate-motion-transport-benchmarks.mjs"
  },
  "devDependencies": {
    "@vcg/game-manifest": "workspace:*",
    "@vcg/launcher-catalog": "workspace:*",
    "@vcg/motion-contract": "workspace:*",
    "@vcg/motion-web-bridge": "workspace:*",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "ws": "8.21.1"
  }
}
