{
  "$id": "urn:vcg:schema:installed-game-manifest:1",
  "title": "VCG installed-root game manifest v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "documentType": {
      "type": "string",
      "const": "vcg-installed-game-manifest"
    },
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "id": {
      "type": "string",
      "maxLength": 80,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[!-~]+$"
    },
    "runtime": {
      "type": "string",
      "enum": [
        "libretro",
        "native"
      ]
    },
    "compatibilityStatus": {
      "type": "string",
      "enum": [
        "qualified",
        "unverified"
      ]
    },
    "launch": {
      "type": "object",
      "properties": {
        "timeoutMs": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 120000
        },
        "healthCheck": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "process",
                "explicit-ready"
              ]
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": {}
        }
      },
      "required": [
        "timeoutMs",
        "healthCheck"
      ],
      "additionalProperties": {}
    },
    "entrypoint": {
      "type": "string",
      "minLength": 1
    },
    "libretro": {
      "type": "object",
      "properties": {
        "content": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "mode": {
                  "type": "string",
                  "const": "none"
                }
              },
              "required": [
                "mode"
              ],
              "additionalProperties": {}
            },
            {
              "type": "object",
              "properties": {
                "mode": {
                  "type": "string",
                  "const": "managed"
                },
                "format": {
                  "type": "string",
                  "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              },
              "required": [
                "mode",
                "format",
                "sha256"
              ],
              "additionalProperties": {}
            },
            {
              "type": "object",
              "properties": {
                "mode": {
                  "type": "string",
                  "const": "library"
                },
                "systemId": {
                  "type": "string",
                  "maxLength": 64,
                  "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                },
                "coreId": {
                  "type": "string",
                  "maxLength": 64,
                  "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                }
              },
              "required": [
                "mode",
                "systemId",
                "coreId"
              ],
              "additionalProperties": {}
            }
          ]
        },
        "frontend": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
            },
            "version": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "license": {
              "type": "string",
              "minLength": 1
            },
            "source": {
              "type": "string",
              "pattern": "^https:\\/\\/"
            }
          },
          "required": [
            "id",
            "version",
            "license",
            "source"
          ],
          "additionalProperties": {}
        },
        "core": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
            },
            "version": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "license": {
              "type": "string",
              "minLength": 1
            },
            "source": {
              "type": "string",
              "pattern": "^https:\\/\\/"
            },
            "architectures": {
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "aarch64",
                  "x86_64"
                ]
              }
            },
            "supportsNoGame": {
              "type": "boolean"
            }
          },
          "required": [
            "id",
            "version",
            "license",
            "source",
            "architectures",
            "supportsNoGame"
          ],
          "additionalProperties": {}
        },
        "controllerProfile": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "saveNamespace": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "bios": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "required": {
                "type": "boolean"
              },
              "license": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "id",
              "sha256",
              "required",
              "license"
            ],
            "additionalProperties": {}
          }
        }
      },
      "required": [
        "content"
      ],
      "additionalProperties": {}
    }
  },
  "required": [
    "documentType",
    "schemaVersion",
    "id",
    "version",
    "runtime",
    "compatibilityStatus",
    "launch"
  ],
  "additionalProperties": {},
  "allOf": [
    {
      "if": {
        "properties": {
          "runtime": {
            "const": "native"
          }
        },
        "required": [
          "runtime"
        ]
      },
      "then": {
        "not": {
          "required": [
            "libretro"
          ]
        }
      }
    },
    {
      "if": {
        "required": [
          "libretro"
        ],
        "properties": {
          "libretro": {
            "required": [
              "content"
            ],
            "properties": {
              "content": {
                "required": [
                  "mode"
                ],
                "properties": {
                  "mode": {
                    "const": "none"
                  }
                }
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "libretro": {
            "required": [
              "core"
            ],
            "properties": {
              "core": {
                "required": [
                  "supportsNoGame"
                ],
                "properties": {
                  "supportsNoGame": {
                    "const": true
                  }
                }
              }
            }
          }
        }
      }
    }
  ],
  "$comment": "parseInstalledGameManifest additionally compares the entrypoint with the selected core and requires artifact hashes on a qualified manifest; standard JSON Schema cannot express those cross-property constraints."
}
