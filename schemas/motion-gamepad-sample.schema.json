{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "epochId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
    },
    "sequence": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "occurredAtMs": {
      "type": "number",
      "minimum": 0
    },
    "trackerHealth": {
      "type": "string",
      "enum": [
        "starting",
        "ready",
        "degraded",
        "fault"
      ]
    },
    "playerAuthorized": {
      "type": "boolean"
    },
    "leanX": {
      "anyOf": [
        {
          "type": "number",
          "minimum": -1,
          "maximum": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "actions": {
      "maxItems": 10,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "enum": [
              "player_join",
              "jump",
              "duck",
              "dodge_left",
              "dodge_right",
              "menu_swipe_left",
              "menu_swipe_right",
              "menu_swipe_up",
              "menu_swipe_down",
              "menu_select",
              "menu_back",
              "pause"
            ]
          },
          "phase": {
            "type": "string",
            "enum": [
              "started",
              "held",
              "triggered",
              "ended",
              "cancelled"
            ]
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "occurredAtMs": {
            "type": "number",
            "minimum": 0
          },
          "durationMs": {
            "type": "number",
            "minimum": 0
          }
        },
        "required": [
          "name",
          "phase",
          "confidence",
          "occurredAtMs"
        ]
      }
    }
  },
  "required": [
    "epochId",
    "sequence",
    "occurredAtMs",
    "trackerHealth",
    "playerAuthorized",
    "leanX",
    "actions"
  ],
  "$id": "urn:vcg:schema:motion-gamepad-sample:1",
  "title": "VCG Motion-to-gamepad research sample v1",
  "$comment": "Research input only. It grants no player, manifest, native-device, game, shell, or reserved-input authority."
}
