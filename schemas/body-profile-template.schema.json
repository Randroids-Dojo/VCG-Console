{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "$ref": "#/$defs/__schema0"
    },
    "profileId": {
      "$ref": "#/$defs/__schema1"
    },
    "templateRevision": {
      "$ref": "#/$defs/__schema2"
    },
    "calibrationRevision": {
      "$ref": "#/$defs/__schema3"
    },
    "calibrationContextSha256": {
      "$ref": "#/$defs/__schema4"
    },
    "status": {
      "$ref": "#/$defs/__schema5"
    },
    "invalidationReason": {
      "$ref": "#/$defs/__schema6"
    },
    "features": {
      "$ref": "#/$defs/__schema7"
    }
  },
  "required": [
    "schemaVersion",
    "profileId",
    "templateRevision",
    "calibrationRevision",
    "calibrationContextSha256",
    "status",
    "invalidationReason",
    "features"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "number",
      "const": 1
    },
    "__schema1": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
    },
    "__schema2": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "__schema3": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "__schema4": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "__schema5": {
      "type": "string",
      "enum": [
        "active",
        "opted-out",
        "invalidated"
      ]
    },
    "__schema6": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "matching-disabled",
            "recalibration",
            "room-or-camera-change",
            "feature-schema-change",
            "vault-key-loss",
            "factory-reset",
            "profile-deleted"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "__schema7": {
      "type": "object",
      "properties": {
        "featureSchemaId": {
          "type": "string",
          "const": "core17-body-ratios-v1"
        },
        "extractorId": {
          "type": "string",
          "const": "camera-free-synthetic-core17-ratios-v1"
        },
        "sampleCount": {
          "type": "integer",
          "minimum": 30,
          "maximum": 300
        },
        "ratios": {
          "type": "object",
          "properties": {
            "shoulderWidthOverTorso": {
              "$ref": "#/$defs/__schema8"
            },
            "hipWidthOverTorso": {
              "$ref": "#/$defs/__schema8"
            },
            "upperArmOverTorso": {
              "$ref": "#/$defs/__schema8"
            },
            "forearmOverTorso": {
              "$ref": "#/$defs/__schema8"
            },
            "thighOverTorso": {
              "$ref": "#/$defs/__schema8"
            },
            "shinOverTorso": {
              "$ref": "#/$defs/__schema8"
            }
          },
          "required": [
            "shoulderWidthOverTorso",
            "hipWidthOverTorso",
            "upperArmOverTorso",
            "forearmOverTorso",
            "thighOverTorso",
            "shinOverTorso"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "featureSchemaId",
        "extractorId",
        "sampleCount",
        "ratios"
      ],
      "additionalProperties": false
    },
    "__schema8": {
      "type": "number",
      "minimum": 0.2,
      "maximum": 2.5
    }
  }
}
