                "type": "string",
                "enum": [
                  "body.core17",
                  "body.mediapipe33",
                  "body.world3d",
                  "actions.obstacle.v1",
                  "actions.shell.v1"
                ]
              }
            },
            "maxPlayers": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "coordinateSystem": {
              "type": "string",
              "const": "image.normalized.top-left"
            },
            "timestampQuality": {
              "type": "string",
              "enum": [
                "camera-exposure",
                "capture-arrival",
                "replay"
              ]
