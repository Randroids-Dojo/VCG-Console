{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "attemptId": {
      "$ref": "#/$defs/__schema0"
    },
    "epochId": {
      "$ref": "#/$defs/__schema0"
    },
    "occurredAtMs": {
      "type": "number",
      "minimum": 0
    },
    "trackerHealth": {
      "type": "string",
      "enum": [
        "starting",
        "ready",
        "degraded",
        "fault"
      ]
    },
    "matchingEnabled": {
      "type": "boolean"
    },
    "singlePlayerVisible": {
      "type": "boolean"
    },
    "calibrationContextSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "features": {
      "type": "object",
      "properties": {
        "featureSchemaId": {
          "type": "string",
          "const": "core17-body-ratios-v1"
        },
        "extractorId": {
          "type": "string",
          "const": "camera-free-synthetic-core17-ratios-v1"
        },
        "sampleCount": {
          "type": "integer",
          "minimum": 30,
          "maximum": 300
        },
        "ratios": {
          "type": "object",
          "properties": {
            "shoulderWidthOverTorso": {
              "$ref": "#/$defs/__schema1"
            },
            "hipWidthOverTorso": {
              "$ref": "#/$defs/__schema1"
            },
            "upperArmOverTorso": {
              "$ref": "#/$defs/__schema1"
            },
            "forearmOverTorso": {
              "$ref": "#/$defs/__schema1"
            },
            "thighOverTorso": {
              "$ref": "#/$defs/__schema1"
            },
            "shinOverTorso": {
              "$ref": "#/$defs/__schema1"
            }
          },
          "required": [
            "shoulderWidthOverTorso",
            "hipWidthOverTorso",
            "upperArmOverTorso",
            "forearmOverTorso",
            "thighOverTorso",
            "shinOverTorso"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "featureSchemaId",
        "extractorId",
        "sampleCount",
        "ratios"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "attemptId",
    "epochId",
    "occurredAtMs",
    "trackerHealth",
    "matchingEnabled",
    "singlePlayerVisible",
    "calibrationContextSha256",
    "features"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
    },
    "__schema1": {
      "type": "number",
      "minimum": 0.2,
      "maximum": 2.5
    }
  }
}
