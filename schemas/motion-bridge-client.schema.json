{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "vcg.motion.hello"
        },
        "protocolVersion": {
          "type": "number",
          "const": 1
        },
        "clientId": {
          "type": "string",
          "maxLength": 80,
          "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
        },
        "request": {
          "type": "object",
          "properties": {
            "requiredProfiles": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "body.core17",
                  "body.mediapipe33",
                  "body.world3d",
                  "actions.obstacle.v1",
                  "actions.shell.v1"
                ]
              }
            },
            "optionalProfiles": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "body.core17",
                  "body.mediapipe33",
                  "body.world3d",
                  "actions.obstacle.v1",
                  "actions.shell.v1"
                ]
              }
            }
          },
          "required": [
            "requiredProfiles",
            "optionalProfiles"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "type",
        "protocolVersion",
        "clientId",
        "request"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "vcg.motion.goodbye"
        },
        "protocolVersion": {
          "type": "number",
          "const": 1
        },
        "sessionId": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "type",
        "protocolVersion",
        "sessionId"
      ],
      "additionalProperties": false
    }
  ]
}
