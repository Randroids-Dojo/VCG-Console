            "properties": {
              "profiles": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "body.core17",
                    "body.mediapipe33",
                    "body.world3d",
                    "actions.obstacle.v1",
                    "actions.shell.v1"
                  ]
                }
              },
              "maxPlayers": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "coordinateSpecVersion": {
                "type": "string",
                "const": "0.1.0"
              },
              "coordinateSystem": {
                "type": "string",
                "const": "image.normalized.top-left"
              },
              "worldCoordinateSystem": {
                "type": "string",
                "const": "player.metric.hip-origin.provider-axes"
              },
              "timestampQuality": {
                "type": "string",
                "enum": [
                  "camera-exposure",
                  "capture-arrival",
                  "replay"
                ]
              }
            },
            "required": [
              "profiles",
              "maxPlayers",
              "coordinateSpecVersion",
              "coordinateSystem",
              "timestampQuality"
            ],
            "additionalProperties": false
          },
