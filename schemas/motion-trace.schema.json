                "confidence": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "state": {
                  "type": "string",
                  "enum": [
                    "candidate",
                    "joined",
                    "lost"
                  ]
                },
                "coreLandmarks": {
                  "minItems": 17,
                  "maxItems": 17,
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "name": {
                        "type": "string",
                        "enum": [
                          "nose",
                          "left_eye",
                          "right_eye",
                          "left_ear",
                          "right_ear",
                          "left_shoulder",
