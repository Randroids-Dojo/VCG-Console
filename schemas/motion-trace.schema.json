      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "schemaVersion": {
                "type": "string",
                "const": "0.4.0"
              },
              "sequence": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "source": {
                "type": "string",
                "enum": [
                  "mediapipe-web",
                  "rtmo-native",
                  "replay",
                  "synthetic"
                ]
              },
              "occurredAtMs": {
                "type": "number",
                "minimum": 0
              },
              "status": {
                "type": "string",
                "const": "starting"
              },
              "reason": {
                "type": "string",
                "enum": [
                  "initializing",
                  "restarting"
                ]
              },
              "controlAvailability": {
                "type": "string",
                "const": "blocked"
              }
            },
            "required": [
              "schemaVersion",
              "sequence",
              "source",
              "occurredAtMs",
              "status",
              "reason",
              "controlAvailability"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "schemaVersion": {
                "type": "string",
                "const": "0.4.0"
              },
              "sequence": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "source": {
                "type": "string",
                "enum": [
                  "mediapipe-web",
                  "rtmo-native",
                  "replay",
                  "synthetic"
                ]
              },
              "occurredAtMs": {
                "type": "number",
                "minimum": 0
              },
              "status": {
                "type": "string",
                "const": "ready"
              },
              "reason": {
                "type": "string",
                "const": "healthy"
              },
              "controlAvailability": {
                "type": "string",
                "const": "full"
              }
            },
            "required": [
              "schemaVersion",
              "sequence",
              "source",
              "occurredAtMs",
              "status",
              "reason",
              "controlAvailability"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "schemaVersion": {
                "type": "string",
                "const": "0.4.0"
              },
              "sequence": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "source": {
                "type": "string",
                "enum": [
                  "mediapipe-web",
                  "rtmo-native",
                  "replay",
                  "synthetic"
                ]
              },
              "occurredAtMs": {
                "type": "number",
                "minimum": 0
              },
              "status": {
                "type": "string",
                "const": "degraded"
              },
              "reason": {
                "type": "string",
                "enum": [
                  "low-confidence",
                  "overload",
                  "fallback-backend"
                ]
              },
              "controlAvailability": {
                "type": "string",
                "const": "landmarks-only"
              }
            },
            "required": [
              "schemaVersion",
              "sequence",
              "source",
              "occurredAtMs",
              "status",
              "reason",
              "controlAvailability"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "schemaVersion": {
                "type": "string",
                "const": "0.4.0"
              },
              "sequence": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "source": {
                "type": "string",
                "enum": [
                  "mediapipe-web",
                  "rtmo-native",
                  "replay",
                  "synthetic"
                ]
              },
              "occurredAtMs": {
                "type": "number",
                "minimum": 0
              },
              "status": {
                "type": "string",
                "const": "fault"
              },
              "reason": {
                "type": "string",
                "enum": [
                  "camera-unavailable",
                  "camera-disconnected",
                  "backend-fault"
                ]
              },
              "controlAvailability": {
                "type": "string",
                "const": "blocked"
              }
            },
            "required": [
              "schemaVersion",
              "sequence",
              "source",
              "occurredAtMs",
              "status",
              "reason",
              "controlAvailability"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "frames": {
      "minItems": 1,
      "maxItems": 600,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "schemaVersion": {
            "type": "string",
            "const": "0.4.0"
          },
          "sequence": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "source": {
            "type": "string",
            "enum": [
              "mediapipe-web",
              "rtmo-native",
              "replay",
              "synthetic"
            ]
          },
          "sourceTimestampMs": {
            "type": "number",
            "minimum": 0
          },
          "inferenceStartedAtMs": {
            "type": "number",
            "minimum": 0
          },
          "inferenceCompletedAtMs": {
            "type": "number",
            "minimum": 0
          },
          "publishedAtMs": {
            "type": "number",
            "minimum": 0
          },
          "health": {
            "type": "string",
