{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "format": {
      "type": "string",
      "const": "vcg-motion-trace"
    },
    "formatVersion": {
      "type": "number",
      "const": 2
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "containsRawFrames": {
      "type": "boolean",
      "const": false
    },
    "privacy": {
      "type": "object",
      "properties": {
        "containsRawFrames": {
          "type": "boolean",
          "const": false
        },
        "containsAudio": {
          "type": "boolean",
          "const": false
        },
        "containsPortraits": {
          "type": "boolean",
          "const": false
        },
        "containsProfileIdentifiers": {
          "type": "boolean",
          "const": false
        },
        "containsFreeText": {
          "type": "boolean",
          "const": false
        },
        "containsDerivedSkeletons": {
          "type": "boolean",
          "const": true
        },
        "containsTraceLocalTrackIds": {
          "type": "boolean",
          "const": true
        },
        "containsExactExportTime": {
          "type": "boolean",
          "const": true
        }
      },
      "required": [
        "containsRawFrames",
        "containsAudio",
        "containsPortraits",
        "containsProfileIdentifiers",
        "containsFreeText",
        "containsDerivedSkeletons",
        "containsTraceLocalTrackIds",
        "containsExactExportTime"
      ],
      "additionalProperties": false
    },
    "retention": {
      "type": "object",
      "properties": {
        "volatileFrameLimit": {
          "type": "number",
          "const": 600
        },
        "volatileHealthEventLimit": {
          "type": "number",
          "const": 128
        },
        "volatileTrackLimit": {
          "type": "number",
          "const": 64
        },
        "droppedFrames": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "droppedHealthEvents": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "trackLimitReached": {
          "type": "boolean"
        },
        "playerLimitExceeded": {
          "type": "boolean"
        },
        "persistentBeforeExport": {
          "type": "boolean",
          "const": false
        },
        "exportPersistence": {
          "type": "string",
          "const": "user-managed-file"
        },
        "deletionControl": {
          "type": "string",
          "const": "clear-volatile-buffer-and-delete-exported-file"
        }
      },
      "required": [
        "volatileFrameLimit",
        "volatileHealthEventLimit",
        "volatileTrackLimit",
        "droppedFrames",
        "droppedHealthEvents",
        "trackLimitReached",
        "playerLimitExceeded",
        "persistentBeforeExport",
        "exportPersistence",
        "deletionControl"
      ],
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "properties": {
        "motionSchemaVersion": {
          "type": "string",
          "const": "0.4.0"
        },
        "coordinateSpecVersion": {
          "type": "string",
          "const": "0.1.0"
        },
        "frameSources": {
          "minItems": 1,
          "maxItems": 4,
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "mediapipe-web",
              "rtmo-native",
              "replay",
              "synthetic"
            ]
          }
        },
        "timestampQualities": {
          "minItems": 1,
          "maxItems": 3,
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "camera-exposure",
              "capture-arrival",
              "replay"
            ]
          }
        },
        "exportedProfiles": {
          "minItems": 1,
          "maxItems": 5,
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "body.core17",
              "body.mediapipe33",
              "body.world3d",
              "actions.obstacle.v1",
              "actions.shell.v1"
            ]
          }
        }
      },
      "required": [
        "motionSchemaVersion",
        "coordinateSpecVersion",
        "frameSources",
        "timestampQualities",
        "exportedProfiles"
      ],
      "additionalProperties": false
    },
    "healthEvents": {
