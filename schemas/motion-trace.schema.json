                          "right_elbow",
                          "left_wrist",
                          "right_wrist",
                          "left_hip",
                          "right_hip",
                          "left_knee",
                          "right_knee",
                          "left_ankle",
                          "right_ankle"
                        ]
                      },
                      "position": {
                        "type": "object",
                        "properties": {
                          "x": {
                            "type": "number"
                          },
                          "y": {
                            "type": "number"
                          },
                          "z": {
                            "type": "number"
                          }
                        },
                        "required": [
                          "x",
                          "y"
                        ],
                        "additionalProperties": false
                      },
                      "worldPosition": {
                        "type": "object",
                        "properties": {
                          "xMeters": {
                            "type": "number"
                          },
                          "yMeters": {
                            "type": "number"
                          },
                          "zMeters": {
                            "type": "number"
                          }
                        },
                        "required": [
                          "xMeters",
                          "yMeters",
                          "zMeters"
                        ],
                        "additionalProperties": false
                      },
                      "visibility": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      "presence": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      "observed": {
                        "type": "boolean"
                      }
                    },
                    "required": [
                      "name",
                      "position",
                      "visibility",
                      "observed"
                    ],
                    "additionalProperties": false
                  }
