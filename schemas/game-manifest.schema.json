{
  "$id": "urn:vcg:schema:game-manifest:1",
  "title": "VCG game manifest v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "publisher": {
      "type": "string",
      "minLength": 1
    },
    "runtime": {
      "type": "string",
      "enum": [
        "remote-web",
        "local-web",
        "native",
        "libretro"
      ]
    },
    "entrypoint": {
      "type": "string",
      "minLength": 1
    },
    "architectures": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "aarch64",
          "x86_64",
          "web"
        ]
      }
    },
    "permissions": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "gamepad",
          "pointer",
          "keyboard",
          "touch",
          "motion.core17",
          "motion.actions.obstacle",
          "network",
          "persistent-storage"
        ]
      }
    },
    "inputProfiles": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "gamepad",
          "pointer",
          "keyboard",
          "touch",
          "motion.obstacle.v1"
        ]
      }
    },
    "minimumConsoleVersion": {
      "type": "string",
      "minLength": 1
    },
    "network": {
      "type": "string",
      "enum": [
        "required",
        "optional",
        "offline"
      ]
    },
    "allowedOrigins": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uri"
      }
    },
    "compatibilityStatus": {
      "type": "string",
      "enum": [
        "unverified",
        "partial",
        "qualified",
        "blocked"
      ]
    },
    "launch": {
      "type": "object",
      "properties": {
        "timeoutMs": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 120000
        },
        "healthCheck": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "http",
                "process",
                "explicit-ready"
              ]
            },
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024,
              "pattern": "^/(?!/)[^\\\\?#]*$",
              "$comment": "Runtime parsing also rejects malformed percent encoding, unsafe invisible or control Unicode, and encoded unsafe characters."
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": {}
        }
      },
      "required": [
        "timeoutMs",
        "healthCheck"
      ],
      "additionalProperties": {}
    },
    "rights": {
      "type": "object",
      "properties": {
        "distribution": {
          "type": "string",
          "enum": [
            "remote-only",
            "owner-authorized-local",
            "redistributable"
          ]
        },
        "codeLicense": {
          "type": "string",
          "minLength": 1
        },
        "contentLicense": {
          "type": "string",
          "minLength": 1
        },
        "reviewStatus": {
          "type": "string",
          "enum": [
            "unreviewed",
            "owner-confirmed",
            "audited"
          ]
        }
      },
      "required": [
        "distribution",
        "codeLicense",
        "contentLicense",
        "reviewStatus"
      ],
      "additionalProperties": {}
    },
    "libretro": {
      "type": "object",
      "properties": {
        "frontend": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
            },
            "version": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "license": {
              "type": "string",
              "minLength": 1
            },
            "source": {
              "type": "string",
              "format": "uri"
            }
          },
          "required": [
            "id",
            "version",
            "license",
            "source"
          ],
          "additionalProperties": {}
        },
        "core": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
            },
            "version": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "license": {
              "type": "string",
              "minLength": 1
            },
            "source": {
              "type": "string",
              "format": "uri"
            },
            "architectures": {
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "aarch64",
                  "x86_64"
                ]
              }
            },
            "supportsNoGame": {
              "type": "boolean"
            }
          },
          "required": [
            "id",
            "version",
            "license",
            "source",
            "architectures",
            "supportsNoGame"
          ],
          "additionalProperties": {}
        },
        "content": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "mode": {
                  "type": "string",
                  "const": "none"
                }
              },
              "required": [
                "mode"
              ],
              "additionalProperties": {}
            },
            {
              "type": "object",
              "properties": {
                "mode": {
                  "type": "string",
                  "const": "managed"
                },
                "format": {
                  "type": "string",
                  "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              },
              "required": [
                "mode",
                "format",
                "sha256"
              ],
              "additionalProperties": {}
            }
          ]
        },
        "controllerProfile": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "saveNamespace": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "bios": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "required": {
                "type": "boolean"
              },
              "license": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "id",
              "sha256",
              "required",
              "license"
            ],
            "additionalProperties": {}
          }
        }
      },
      "required": [
        "frontend",
        "core",
        "content",
        "controllerProfile",
        "saveNamespace",
        "bios"
      ],
      "additionalProperties": {}
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "version",
    "title",
    "publisher",
    "runtime",
    "entrypoint",
    "architectures",
    "permissions",
    "inputProfiles",
    "minimumConsoleVersion",
    "network",
    "allowedOrigins",
    "compatibilityStatus",
    "launch",
    "rights",
    "notes"
  ],
  "additionalProperties": {},
  "allOf": [
    {
      "if": {
        "properties": {
          "runtime": {
            "const": "remote-web"
          }
        },
        "required": [
          "runtime"
        ]
      },
      "then": {
        "properties": {
          "entrypoint": {
            "pattern": "^https://"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "network": {
            "const": "offline"
          }
        },
        "required": [
          "network"
        ]
      },
      "then": {
        "properties": {
          "permissions": {
            "not": {
              "contains": {
                "const": "network"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "runtime": {
            "const": "libretro"
          }
        },
        "required": [
          "runtime"
        ]
      },
      "then": {
        "required": [
          "libretro"
        ],
        "properties": {
          "entrypoint": {
            "pattern": "^libretro:[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "network": {
            "const": "offline"
          },
          "allowedOrigins": {
            "maxItems": 0
          },
          "architectures": {
            "not": {
              "contains": {
                "const": "web"
              }
            }
          }
        }
      },
      "else": {
        "not": {
          "required": [
            "libretro"
          ]
        }
      }
    }
  ],
  "$comment": "parseGameManifest additionally compares normalized entrypoint/origin values and libretro core/architecture identity; standard JSON Schema cannot express those cross-property constraints."
}
