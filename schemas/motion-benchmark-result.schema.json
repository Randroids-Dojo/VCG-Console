{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "format": {
      "type": "string",
      "const": "vcg-motion-benchmark-result"
    },
    "formatVersion": {
      "type": "number",
      "const": 1
    },
    "protocolId": {
      "type": "string",
      "maxLength": 80,
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
    },
    "runId": {
      "type": "string",
      "maxLength": 80,
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "containsRawFrames": {
      "type": "boolean",
      "const": false
    },
    "traceSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "timestampQuality": {
      "type": "string",
      "enum": [
        "camera-exposure",
        "capture-arrival",
        "replay"
      ]
    },
    "configurationId": {
      "type": "string",
      "maxLength": 80,
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
    },
    "placementId": {
      "type": "string",
      "maxLength": 80,
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
    },
    "personaClass": {
      "type": "string",
      "enum": [
        "school-age-child-standing",
        "adult-standing",
        "exploratory-other"
      ]
    },
    "concurrentWorkload": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "attempts": {
      "maxItems": 10000,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "trialId": {
            "type": "string",
            "maxLength": 80,
            "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
          },
          "repetition": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "completed": {
            "type": "boolean"
          },
          "observedTriggers": {
            "maxItems": 64,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "action": {
                  "type": "string",
                  "enum": [
                    "player_join",
                    "jump",
                    "duck",
                    "dodge_left",
                    "dodge_right",
                    "menu_swipe_left",
                    "menu_swipe_right",
                    "menu_swipe_up",
                    "menu_swipe_down",
                    "menu_select",
                    "menu_back",
                    "pause"
                  ]
                },
                "atMs": {
                  "type": "number",
                  "minimum": 0
                }
              },
              "required": [
                "action",
                "atMs"
              ],
              "additionalProperties": false
            }
          },
          "observedTransitions": {
            "maxItems": 16,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "transition": {
                  "type": "string",
                  "enum": [
                    "freeze",
                    "silent-recovery",
                    "show-recovery",
                    "recovery-resumed"
                  ]
                },
                "atMs": {
                  "type": "number",
                  "minimum": 0
                }
              },
              "required": [
                "transition",
                "atMs"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "trialId",
          "repetition",
          "completed",
          "observedTriggers",
          "observedTransitions"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "format",
    "formatVersion",
    "protocolId",
    "runId",
    "createdAt",
    "containsRawFrames",
    "traceSha256",
    "timestampQuality",
    "configurationId",
    "placementId",
    "personaClass",
    "concurrentWorkload",
    "attempts"
  ],
  "additionalProperties": false
}
